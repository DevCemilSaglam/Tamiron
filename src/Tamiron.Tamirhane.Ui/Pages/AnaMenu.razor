@page "/"
@inject TamironApi Api
@inject NavigationManager Nav
@*
  G1 · Ana menü (EKRANLAR §0, prototip 10-home). Cemil'in sırası: Servis kaydı ekle · Servis
  kayıtları · Araçlar · Müşteriler · Müşteriye mesaj · Muhasebe. Bir MENÜ, pano değil: satır altında
  tek cümlelik sayı, bakım hatırlatması burada YOK (K-019.1). Sayılar API'nin özetinden (GET /api/home).
  ⚠️ Satır mikrofonları ses işiyle gelir (K-080.3) — çalışmayan düğme konmaz.
*@
<section class="screen active" id="screen-home">
  <div class="greeting">
    <h1 id="selam">@selam</h1>
    <p>Bir satıra dokunarak işe başla.</p>
  </div>

  @if (hata is not null)
  {
    <div class="notice warn" role="alert" id="homeHata"><span class="n-body">@hata</span></div>
  }

  <nav class="menu-list" aria-label="Ana menü">
    @foreach (var s in Satirlar)
    {
      <div class="menu-row">
        <button class="main" id="@s.Id" @onclick="() => Nav.NavigateTo(s.Yol)">
          <span class="ic-badge"><svg class="ico"><use href="#@s.Ikon"></use></svg></span>
          <span class="txt"><span class="lbl">@s.Ad</span>
            <span class="sub" id="@(s.Id)Alt">@Alt(s.Id)</span></span>
        </button>
      </div>
    }
  </nav>

  <button class="btn btn-ghost" id="cikis" @onclick="Cikis">Çıkış yap</button>
</section>

@code {
    record Satir(string Id, string Ad, string Yol, string Ikon, string? Sabit = null);

    static readonly Satir[] Satirlar =
    [
        new("menuEkle", "Servis kaydı ekle", "/kayit-ac", "i-plus", "Araç geldi · iş açılıyor"),
        new("menuKayitlar", "Servis kayıtları", "/kayitlar", "i-clipboard-list"),
        new("menuAraclar", "Araçlar", "/araclar", "i-car"),
        new("menuMusteriler", "Müşteriler", "/musteriler", "i-users"),
        new("menuMesaj", "Müşteriye mesaj", "/mesaj", "i-message-square", "WhatsApp · özet · hatırlatma"),
        new("menuMuhasebe", "Muhasebe", "/muhasebe", "i-receipt"),
    ];

    HomeSummary? ozet;
    string selam = Selam.Metni(DateTime.Now);
    string? hata;

    // Prototip 10-home ciz(): aynı cümleler.
    string Alt(string id)
    {
        var sabit = Satirlar.First(s => s.Id == id).Sabit;
        if (sabit is not null) return sabit;
        if (ozet is null) return "—";
        return id switch
        {
            "menuKayitlar" => ozet.InShopCount > 0 ? $"{ozet.InShopCount} araç serviste · {ozet.RecordCount} kayıt"
                                                   : $"{ozet.RecordCount} kayıt · serviste araç yok",
            "menuAraclar" => $"{ozet.VehicleCount} araç kayıtlı",
            "menuMusteriler" => $"{ozet.CustomerCount} müşteri",
            "menuMuhasebe" => $"Bugün {Format.Money(ozet.CollectedToday)} ₺ · {Format.Money(ozet.Receivable)} ₺ veresiye",
            _ => "",
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await Api.HasSessionAsync()) { Nav.NavigateTo("/giris"); return; }
        try { ozet = await Api.HomeAsync(); }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized) { Nav.NavigateTo("/giris"); }
        catch (ApiException e) { hata = e.Message; }
    }

    async Task Cikis()
    {
        try { await Api.LogoutAsync(); } catch (ApiException) { }   // anahtar yine de silindi
        Nav.NavigateTo("/giris");
    }
}
