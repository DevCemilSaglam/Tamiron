<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tamiron.Application\Tamiron.Application.csproj" />
    <ProjectReference Include="..\Tamiron.Infrastructure\Tamiron.Infrastructure.csproj" />
    <!-- G1 · Arayüzü API sunar (K-080.1): tek komut, tek adres. -->
    <ProjectReference Include="..\Tamiron.Tamirhane.Web\Tamiron.Tamirhane.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- D18 · OpenAPI belgesi (yalnız geliştirme/test). .NET 8'de belge üretimi ayrı pakette. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.33" />
  </ItemGroup>

  <ItemGroup>
    <!-- D15 · Sesli işlem şemaları — prototipten üretilir (node tools/ses-sema-dok.js), elle düzenlenmez. -->
    <Content Update="Ses\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- D16 · Geliştirme tohumu — prototipten üretilir (node tools/muhasebe-esdeger.js). -->
    <Content Update="Seed\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
