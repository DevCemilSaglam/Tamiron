@inject TamironApi Api
@inject NavigationManager Nav
@*
  H7 · Ortak giriş formu (iki uygulama: tamirhane "/", yedek parça "/parca/" — K-091). Sayfayı her uygulama kendi
  yolunda açar; form hangi TÜR için olduğunu bilir: başka türün numarası girerse oturum kapanır ve nereden
  gireceği söylenir (yetki API'de de var — 403; burada usta boş ekranla kalmasın).
  D20 · Giriş (K-074): telefon → SMS kodu → içeride, SÜRESİZ. Prototipte giriş ekranı yoktu;
  dil prototipinki: konuşan düğme (K-033.3) — düğme kapanmaz, eksik olanı SÖYLER.
  Hata metni API'nin Türkçe başlığı; ekran kendi cümlesini uydurmaz.
  G1 · Kayıtlı olmayan numara (auth.unknown_phone) kayda yönlenir (D6): dükkân adı → kod → içeride.
  Yerel kurulumda kod SMS ile değil sunucu penceresinde görünür (K-080.1).
*@
<section class="screen active" id="screen-giris">
  <div class="screen-head">
    <span class="eyebrow">@(kayit ? "Dükkânını kaydet" : Kind == "YedekParca" ? "Yedek parça girişi" : "Tamiron'a giriş")</span>
  </div>

  <div class="card">
    @if (!kodGitti && !kayit)
    {
      <div class="field">
        <label for="grTel">Telefonun</label>
        <input id="grTel" type="tel" inputmode="tel" autocomplete="tel" placeholder="0532 215 30 00"
               @bind="telefon" @bind:event="oninput" />
      </div>
      <button class="btn btn-primary btn-lg" id="grKodIste" @onclick="KodIste" disabled="@calisiyor">Kod gönder</button>
      @if (kayitliDegil)
      {
        <button class="btn btn-ghost" id="grKaydol" @onclick="KaydaGec">Dükkânımı kaydet</button>
      }
    }
    else if (!kodGitti)
    {
      <p class="plate-hint">@telefon numarasıyla yeni dükkân açılacak.</p>
      <div class="field">
        <label for="grDukkan">Dükkânının adı</label>
        <input id="grDukkan" autocomplete="organization" placeholder="@DukkanOrnek"
               @bind="dukkan" @bind:event="oninput" />
      </div>
      <button class="btn btn-primary btn-lg" id="grKayitKodIste" @onclick="KayitKoduIste" disabled="@calisiyor">Kod gönder</button>
      <button class="btn btn-ghost" id="grGeri" @onclick="NumarayiDegistir">Numarayı değiştir</button>
    }
    else
    {
      <p class="plate-hint">@telefon numarasına gelen 6 haneli kodu yaz.</p>
      <div class="field">
        <label for="grKod">Kod</label>
        <input id="grKod" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
               @bind="kod" @bind:event="oninput" />
      </div>
      <button class="btn btn-primary btn-lg" id="grGiris" @onclick="GirisYap" disabled="@calisiyor">@(kayit ? "Dükkânı aç" : "Giriş yap")</button>
      <button class="btn btn-ghost" id="grGeri" @onclick="NumarayiDegistir">Numarayı değiştir</button>
    }
  </div>

  @if (hata is not null)
  {
    <div class="notice warn" role="alert" id="grHata"><span class="n-body">@hata</span></div>
  }
</section>

@code {
    /// <summary>"Tamirhane" ya da "YedekParca" — bu formun açıldığı uygulama.</summary>
    [Parameter] public string Kind { get; set; } = "Tamirhane";
    [Parameter] public string DukkanOrnek { get; set; } = "Kaya Oto Servis";

    string telefon = "", kod = "", dukkan = "";
    bool kodGitti, calisiyor, kayit, kayitliDegil;
    string? hata;

    async Task KodIste()
    {
        if (string.IsNullOrWhiteSpace(telefon)) { hata = "Telefonunu yaz."; return; }
        kayitliDegil = false;
        await Calis(async () => { await Api.RequestCodeAsync(telefon); kodGitti = true; });
    }

    void KaydaGec() { kayit = true; hata = null; }

    async Task KayitKoduIste()
    {
        if (string.IsNullOrWhiteSpace(dukkan)) { hata = "Dükkânının adını yaz."; return; }
        await Calis(async () => { await Api.RequestSignupCodeAsync(telefon); kodGitti = true; });
    }

    async Task GirisYap()
    {
        if (kod.Trim().Length != 6) { hata = "Telefonuna gelen 6 haneli kodu yaz."; return; }
        await Calis(async () =>
        {
            var r = kayit ? await Api.SignUpAsync(telefon, kod.Trim(), dukkan.Trim(), "tarayıcı", Kind)
                          : await Api.VerifyAsync(telefon, kod.Trim(), "tarayıcı");
            if (r.Kind != Kind)
            {
                await Api.LogoutAsync();
                hata = r.Kind == "YedekParca"
                    ? "Bu numara bir yedek parçacının. Parçacı uygulamasından gir: /parca/"
                    : "Bu numara bir tamirhanenin. Tamirhane uygulamasından gir: /";
                kodGitti = false; kod = "";
                return;
            }
            Nav.NavigateTo("");   // uygulamanın KENDİ kökü (tamirhane "/", parçacı "/parca/")
        });
    }

    void NumarayiDegistir() { kodGitti = false; kayit = false; kayitliDegil = false; kod = ""; hata = null; }

    async Task Calis(Func<Task> is_)
    {
        hata = null; calisiyor = true;
        try { await is_(); }
        catch (ApiException e)
        {
            hata = e.Message;
            kayitliDegil = e.Code == "auth.unknown_phone";
        }
        finally { calisiyor = false; }
    }
}
