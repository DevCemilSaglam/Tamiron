# uretim ciktisi degil, kaynak degil
node_modules/
prototypes/.omurga.denetim-yedek

# Local Netlify folder
.netlify

# ⚠️ GERÇEK RUHSAT VE PARÇA LİSTESİ FOTOĞRAFLARI — DEPOYA GİRMEZ.
# Ruhsatta TC kimlik no ve adres var (RUHSAT-OKUMA.md Bulgu 2 · A-31);
# parça listelerinde müşteri/parçacı adı geçiyor. Ölçüm için gerekliler,
# saklanmaları için bir sebep yok. Tutmadığın veri en güvenli veridir.
tools/degerlendirme/ruhsatlar/
tools/degerlendirme/parcalar/

# Model koşularının ham çıktıları (içinde okunan alanlar var)
tools/degerlendirme/sonuc-*.json

# ⚠️ KİŞİSEL ÖLÇÜT: TC/vergi no, ad ve adres değerleri (K-050).
# Alanlar ARTIK ÖLÇÜLÜYOR — fatura bunlara kesiliyor — ama 46 gerçek
# insanın kimlik numarası bir GitHub deposunda kalıcı olarak durmaz.
# Fotoğrafların kendisi zaten girmiyor; içindekini yazıya dökünce
# girmesi tutarsız olurdu.
tools/degerlendirme/*-kisisel.json

# Fotograf haritasi: r01..p27 -> diskteki dosya yolu. Makineye ozel
# (yollar Cemil'in masaustunu gosteriyor) ve fotograflar zaten depo disi.
# `foto-esle.js` her makinede yeniden uretir.
tools/degerlendirme/foto-harita.json

# Kontrol sayfasinin URETILMIS hali — icinde kisisel alanlar birlesmis olur.
# Sablon ve ureteci depoda; ciktisi degil.
tools/degerlendirme/kontrol.html

# Ses eşdeğerlik ölçümünün taban kopyası (tools/ses-esdeger.js) — geçici
prototypes/_taban.html

# Ses kayıtları ve indirilen derlem/gürültü dosyaları (SES-OLCUM.md §8) —
# depoya yalnız kaynak + lisans listesi girer.
tools/degerlendirme/sesler/
*.wav

# .NET derleme ciktisi (K-073)
bin/
obj/
.vs/
*.user
TestResults/
